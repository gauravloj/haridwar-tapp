# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Default is SQLite. For production, use PostgreSQL
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Email Configuration (for booking confirmations)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@haridwarpuja.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Razorpay Payment Gateway
# Get these from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Site Configuration
SITE_NAME=Haridwar Puja
PHONE_NUMBER=+91-9412940894
WHATSAPP_NUMBER=+91-9412940894
EMAIL=contact@haridwarpuja.com

# Location
ADDRESS=Kankhal, Haridwar
CITY=Haridwar
STATE=Uttarakhand
COUNTRY=India
LATITUDE=29.9457
LONGITUDE=78.1642

# Social Media URLs
FACEBOOK_URL=https://facebook.com/haridwarpuja
